# AWS credentials used by Next.js Route Handlers (S3 upload / list / delete)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2
AWS_S3_BUCKET_NAME=

# Amazon Cognito (Hosted UI, OAuth 2.0 Authorization Code flow)
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_DOMAIN=
NEXT_PUBLIC_COGNITO_REGION=ap-southeast-2
NEXT_PUBLIC_COGNITO_REDIRECT_SIGN_IN=http://localhost:3002/auth/callback
NEXT_PUBLIC_COGNITO_REDIRECT_SIGN_OUT=http://localhost:3002

# API Gateway + Lambda endpoints
NEXT_PUBLIC_SPLIT_NAME_API_URL=
NEXT_PUBLIC_DYNAMO_SELECT_API_URL=
NEXT_PUBLIC_DYNAMO_DELETE_API_URL=
